@model IEnumerable<WebApp.Models.Food>

@{
    ViewData["Title"] = "Menu";
}

<h2>Our Menu</h2>

<!-- Filter by category -->
<div class="mb-3">
    <a asp-action="Index" class="btn @(ViewBag.SelectedCategory == null ? "btn-primary" : "btn-outline-primary") me-1">All</a>
    @foreach (var category in ViewBag.Categories as List<WebApp.Models.FoodCategory>)
    {
        <a asp-action="Index" asp-route-categoryId="@category.Id"
           class="btn @(ViewBag.SelectedCategory == category.Id ? "btn-primary" : "btn-outline-primary") me-1">
            @category.Name
        </a>
    }
</div>

<!-- Food grid -->
<div class="row">
    @foreach (var food in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                @if (!string.IsNullOrEmpty(food.ImageUrl))
                {
                    <img src="@food.ImageUrl" class="card-img-top" alt="@food.Title" style="height:200px; object-fit:cover;" />
                }
                <div class="card-body">
                    <h5 class="card-title">@food.Title</h5>
                    <p class="card-text text-muted">@food.Description</p>
                    @if (food.FoodAllergens.Any())
                    {
                        <p class="card-text">
                            <small class="text-danger">
                                Allergens: @string.Join(", ", food.FoodAllergens.Select(fa => fa.Allergen.Name))
                            </small>
                        </p>
                    }
                    <p class="card-text"><strong>@food.Price €</strong></p>
                </div>
                <div class="card-footer">
                    <button class="btn btn-primary btn-sm add-to-cart"
                            data-id="@food.Id"
                            data-title="@food.Title"
                            data-price="@food.Price">
                        Add to Cart
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<!-- Cart summary -->
<div class="fixed-bottom bg-light p-3 border-top" id="cartBar" style="display:none;">
    <div class="container d-flex justify-content-between align-items-center">
        <span id="cartSummary"></span>
        <a asp-action="Cart" class="btn btn-success">Proceed to Order</a>
    </div>
</div>

@section Scripts {
    <script>
        let cart = JSON.parse(localStorage.getItem('cart') || '[]');
        updateCartBar();

        $('.add-to-cart').click(function () {
            const id = $(this).data('id');
            const title = $(this).data('title');
            const price = parseFloat($(this).data('price'));

            const existing = cart.find(x => x.id === id);
            if (existing) {
                existing.quantity++;
            } else {
                cart.push({ id, title, price, quantity: 1 });
            }

            localStorage.setItem('cart', JSON.stringify(cart));
            updateCartBar();
        });

        function updateCartBar() {
            if (cart.length === 0) {
                $('#cartBar').hide();
                return;
            }
            const total = cart.reduce((sum, x) => sum + x.price * x.quantity, 0);
            const count = cart.reduce((sum, x) => sum + x.quantity, 0);
            $('#cartSummary').text(`${count} items - ${total.toFixed(2)} €`);
            $('#cartBar').show();
        }
    </script>
}