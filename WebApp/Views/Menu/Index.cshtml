@{
    ViewData["Title"] = "Menu";
}

<h2>Our Menu</h2>

<!-- Filter -->
<div class="mb-3 d-flex gap-2 flex-wrap">
    <input type="text" id="searchTitle" class="form-control w-auto" placeholder="Search food..." value="@ViewBag.SearchTitle" />
    <button id="searchBtn" class="btn btn-outline-primary">Search</button>
    <button id="clearBtn" class="btn btn-outline-secondary">Clear</button>
</div>

<div class="mb-3">
    <button class="btn @(ViewBag.SelectedCategory == null ? "btn-primary" : "btn-outline-primary") me-1"
            data-category="">
        All
    </button>
    @foreach (var category in ViewBag.Categories as List<WebApp.Models.FoodCategory>)
    {
        <button class="btn @(ViewBag.SelectedCategory != null && ViewBag.SelectedCategory == category.Id ? "btn-primary" : "btn-outline-primary") me-1 category-btn"
                data-category="@category.Id">
            @category.Name
        </button>
    }
</div>

<!-- Partial placeholder -->
<div id="menuPlaceholder"></div>

<!-- Cart bar -->
<div class="fixed-bottom bg-light p-3 border-top" id="cartBar" style="display:none;">
    <div class="container d-flex justify-content-between align-items-center">
        <span id="cartSummary"></span>
        <a asp-controller="Menu" asp-action="Cart" class="btn btn-success">Proceed to Order</a>
    </div>
</div>

@section Scripts {
    <script>
        let cart = JSON.parse(localStorage.getItem('cart') || '[]');
        let currentPage = 1;
        let currentCategory = @(ViewBag.SelectedCategory ?? (object)"null");
        let currentTitle = '@(ViewBag.SearchTitle ?? "")';

        updateCartBar();
        loadMenu();

        function loadMenu() {
            let url = `/Menu/SearchPartial?page=${currentPage}`;
            if (currentCategory) url += `&categoryId=${currentCategory}`;
            if (currentTitle) url += `&title=${currentTitle}`;

            $('#menuPlaceholder').load(url, function () {
                bindPagination();
                bindAddToCart();
            });
        }

        function bindPagination() {
            $('.page-num').click(function (e) {
                e.preventDefault();
                currentPage = parseInt($(this).data('page'));
                loadMenu();
            });

            $('.prev-page').click(function (e) {
                e.preventDefault();
                if (currentPage > 1) {
                    currentPage--;
                    loadMenu();
                }
            });

            $('.next-page').click(function (e) {
                e.preventDefault();
                currentPage++;
                loadMenu();
            });
        }

        function bindAddToCart() {
            $('.add-to-cart').click(function () {
                const id = $(this).data('id');
                const title = $(this).data('title');
                const price = parseFloat($(this).data('price'));

                const existing = cart.find(x => x.id === id);
                if (existing) {
                    existing.quantity++;
                } else {
                    cart.push({ id, title, price, quantity: 1 });
                }

                localStorage.setItem('cart', JSON.stringify(cart));
                updateCartBar();
            });
        }

        $('.category-btn, button[data-category=""]').click(function () {
            const cat = $(this).data('category');
            currentCategory = cat || null;
            currentPage = 1;

            $('.category-btn, button[data-category=""]').removeClass('btn-primary').addClass('btn-outline-primary');
            $(this).removeClass('btn-outline-primary').addClass('btn-primary');

            loadMenu();
        });

        $('#searchBtn').click(function () {
            currentTitle = $('#searchTitle').val();
            currentPage = 1;
            loadMenu();
        });

        $('#clearBtn').click(function () {
            currentTitle = '';
            currentCategory = null;
            currentPage = 1;
            $('#searchTitle').val('');
            $('.category-btn, button[data-category=""]').removeClass('btn-primary').addClass('btn-outline-primary');
            $('button[data-category=""]').removeClass('btn-outline-primary').addClass('btn-primary');
            loadMenu();
        });

        function updateCartBar() {
            if (cart.length === 0) {
                $('#cartBar').hide();
                return;
            }
            const total = cart.reduce((sum, x) => sum + x.price * x.quantity, 0);
            const count = cart.reduce((sum, x) => sum + x.quantity, 0);
            $('#cartSummary').text(`${count} items - ${total.toFixed(2)} €`);
            $('#cartBar').show();
        }
    </script>
}