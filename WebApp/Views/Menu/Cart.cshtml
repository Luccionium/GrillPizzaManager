@{
    ViewData["Title"] = "Your Order";
}

<h2>Your Order</h2>
<hr />

<div id="cartItems"></div>

<div class="mt-3">
    <h4>Total: <span id="cartTotal">0.00</span> €</h4>
</div>

<hr />

<form id="orderForm">
    <div class="row">
        <div class="col-md-4">
            <div class="form-group mb-3">
                <label>Adresa dostave *</label>
                <input type="text" id="deliveryAddress" class="form-control" placeholder="Unesite adresu dostave" required />
            </div>
            <div class="form-group mb-3">
                <label>Note (optional)</label>
                <textarea id="orderNote" class="form-control" rows="3"></textarea>
            </div>
            <button type="button" id="placeOrder" class="btn btn-success">Place Order</button>
            <a asp-action="Index" class="btn btn-secondary">Back to Menu</a>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        let cart = JSON.parse(localStorage.getItem('cart') || '[]');
        renderCart();

        function renderCart() {
            if (cart.length === 0) {
                $('#cartItems').html('<p>Your cart is empty. <a href="/Menu">Go to menu</a></p>');
                $('#placeOrder').hide();
                return;
            }

            let html = '<table class="table"><thead><tr><th>Item</th><th>Price</th><th>Quantity</th><th>Subtotal</th><th></th></tr></thead><tbody>';
            let total = 0;

            cart.forEach((item, index) => {
                const subtotal = item.price * item.quantity;
                total += subtotal;
                html += `<tr>
                    <td>${item.title}</td>
                    <td>${item.price.toFixed(2)} €</td>
                    <td>
                        <button class="btn btn-sm btn-outline-secondary" onclick="changeQty(${index}, -1)">-</button>
                        ${item.quantity}
                        <button class="btn btn-sm btn-outline-secondary" onclick="changeQty(${index}, 1)">+</button>
                    </td>
                    <td>${subtotal.toFixed(2)} €</td>
                    <td><button class="btn btn-sm btn-danger" onclick="removeItem(${index})">Remove</button></td>
                </tr>`;
            });

            html += '</tbody></table>';
            $('#cartItems').html(html);
            $('#cartTotal').text(total.toFixed(2));
        }

        function changeQty(index, delta) {
            cart[index].quantity += delta;
            if (cart[index].quantity <= 0) cart.splice(index, 1);
            localStorage.setItem('cart', JSON.stringify(cart));
            renderCart();
        }

        function removeItem(index) {
            cart.splice(index, 1);
            localStorage.setItem('cart', JSON.stringify(cart));
            renderCart();
        }

        $('#placeOrder').click(function () {
            $.ajax({
                url: '/Menu/PlaceOrder',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ 
                    items: cart,
                     note: $('#orderNote').val(),
          deliveryAddress: $('#deliveryAddress').val()}),
                success: function () {
                    localStorage.removeItem('cart');
                    window.location.href = '/Menu/OrderConfirmation';
                },
                error: function () {
                    alert('Error placing order. Please try again.');
                }
            });
        });
    </script>
}