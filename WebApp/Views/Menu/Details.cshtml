@model WebApp.Models.Food

@{
    ViewData["Title"] = @Model.Title;
}

<div class="row">
    <div class="col-md-6">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="@Model.Title" class="img-fluid rounded mb-3" />
        }
    </div>
    <div class="col-md-6">
        <h2>@Model.Title</h2>
        <p class="text-muted">@Model.FoodCategory?.Name</p>
        <p>@Model.Description</p>
        <h4>@Model.Price €</h4>

        @if (Model.FoodAllergens.Any())
        {
            <div class="alert alert-warning">
                <strong>Allergens:</strong>
                @string.Join(", ", Model.FoodAllergens.Select(fa => fa.Allergen.Name))
            </div>
        }

        <button class="btn btn-primary btn-lg add-to-cart"
                data-id="@Model.Id"
                data-title="@Model.Title"
                data-price="@Model.Price">
            Add to Cart
        </button>
        <a asp-action="Index" class="btn btn-secondary btn-lg">Back to Menu</a>
    </div>
</div>
<!-- Cart bar -->
<div class="fixed-bottom bg-light p-3 border-top" id="cartBar" style="display:none;">
    <div class="container d-flex justify-content-between align-items-center">
        <span id="cartSummary"></span>
        <a asp-action="Cart" class="btn btn-success">Proceed to Order</a>
    </div>
</div>

@section Scripts {
    <script>
        let cart = JSON.parse(localStorage.getItem('cart') || '[]');

        $('.add-to-cart').click(function () {
            const id = $(this).data('id');
            const title = $(this).data('title');
            const price = parseFloat($(this).data('price'));

            const existing = cart.find(x => x.id === id);
            if (existing) {
                existing.quantity++;
            } else {
                cart.push({ id, title, price, quantity: 1 });
            }

            localStorage.setItem('cart', JSON.stringify(cart));
            updateCartBar();
            alert('Added to cart!');
        });

        function updateCartBar() {
            if (cart.length === 0) {
                $('#cartBar').hide();
                return;
            }
            const total = cart.reduce((sum, x) => sum + x.price * x.quantity, 0);
            const count = cart.reduce((sum, x) => sum + x.quantity, 0);
            $('#cartSummary').text(`${count} items - ${total.toFixed(2)} €`);
            $('#cartBar').show();
        }
    </script>
}