@model IEnumerable<WebApp.Models.User>

@{
    ViewData["Title"] = "Users & Orders";
}

<h2>Users & Orders</h2>
<hr />

@foreach (var user in Model)
{
    <div class="card mb-3">
        <div class="card-header">
            <strong>@user.Username</strong> — @user.FirstName @user.LastName (@user.Email)
        </div>
        <div class="card-body">
            @if (!user.Orders.Any())
            {
                <p class="text-muted">No orders yet.</p>
            }
            else
            {
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Items</th>
                            <th>Total</th>
                            <th>Delivery Address</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in user.Orders.OrderByDescending(o => o.CreatedAt))
                        {
                            <tr>
                                <td>@order.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@order.OrderItems.Count</td>
                                <td>@order.TotalPrice €</td>
                                <td>@order.DeliveryAddress</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-primary">Details</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

<a asp-action="Index" class="btn btn-secondary">Back to Orders</a>